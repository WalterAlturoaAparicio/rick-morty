{
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "prettier"
  ],
  "env": {
    "node": true,
    "es2021": true
  },
  "rules": {
    "quotes": ["error", "single"],
    "space-before-function-paren": ["error", "always"],
    "@typescript-eslint/no-explicit-any": "warn",
    "prefer-const": "error"
  }
}
